NODE_ENV=development
PORT=5000
DB_URI=mongodb+srv://...
JWT_SECRET=replace-with-a-long-random-secret
GROQ_API_KEY=replace-me

# OAuth callback target for this backend deployment.
# Local: http://localhost:5000
# Production: https://your-backend.example.com
BACKEND_BASE_URL=http://localhost:5000

# Browser origin that receives the OAuth token after callback.
# Local: http://localhost:3000/auth/success
# Production: https://your-frontend.example.com/auth/success
FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_SUCCESS_URL=http://localhost:3000/auth/success

GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me
GITHUB_CLIENT_ID=replace-me
GITHUB_CLIENT_SECRET=replace-me

CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me
